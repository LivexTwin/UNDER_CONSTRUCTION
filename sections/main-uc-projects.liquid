{% assign first_project = section.blocks | first %}

<section class="uc-projects" aria-labelledby="uc-projects-title">
  {% if first_project != blank %}
    <div class="uc-projects__layout">

      <div class="uc-projects__left">
  

        <div class="uc-projects__selected" data-selected>
          <div class="uc-projects__selected-image" data-selected-image>
            {% if first_project.settings.image != blank %}
              {{
                first_project.settings.image
                | image_url: width: 2000
                | image_tag:
                  widths: '600, 900, 1200, 1600, 2000',
                  sizes: '(min-width: 750px) 40vw, 100vw',
                  loading: 'eager',
                  alt: first_project.settings.image_alt
              }}
            {% endif %}
          </div>

          <div class="uc-projects__selected-copy" data-selected-copy>
 <div data-selected-description>
  {{ first_project.settings.description }}
</div>
          </div>
        </div>
      </div>

      <div class="uc-projects__index" data-project-index>
              <header class="uc-projects__header">
          <h1 id="uc-projects-title">PROJECTS</h1>

          {% if section.settings.supporting_text != blank %}
            <p>{{ section.settings.supporting_text | escape }}</p>
          {% endif %}
        </header>
        <div class="uc-projects__list" data-project-list aria-label="Projects">
       {% for block in section.blocks %}
  {% assign metadata_lines = block.settings.metadata | newline_to_br | split: '<br />' %}

  {%- comment -%} DESKTOP PROJECT ROW {%- endcomment -%}

 {% if block.settings.destination != blank %}
  <a
    class="uc-projects__item"
    href="{{ block.settings.destination }}"
    data-project-item
    data-project-name="{{ block.settings.name | escape }}"
    data-project-description="{{ block.settings.description | escape }}"
    data-project-image="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 2000 }}{% endif %}"
    data-project-image-srcset="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: 2000 }} 2000w{% endif %}"
    data-project-alt="{{ block.settings.image_alt | escape }}"
    {{ block.shopify_attributes }}
  >
{% else %}
  <button
    class="uc-projects__item"
    type="button"
    data-project-item
    data-project-name="{{ block.settings.name | escape }}"
    data-project-description="{{ block.settings.description | escape }}"
    data-project-image="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 2000 }}{% endif %}"
    data-project-image-srcset="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: 2000 }} 2000w{% endif %}"
    data-project-alt="{{ block.settings.image_alt | escape }}"
    aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
    {{ block.shopify_attributes }}
  >
{% endif %}
    <span class="uc-projects__name">
      {{ block.settings.name | escape }}
    </span>

    <span class="uc-projects__metadata-list">
      {% for line in metadata_lines limit: 3 %}
        {% assign metadata_value = line | strip %}
        {% if metadata_value != blank %}
          <span class="uc-projects__metadata">
            {{ metadata_value | escape }}
          </span>
        {% endif %}
      {% endfor %}
    </span>

    <span class="uc-projects__status">
      {{ block.settings.status | escape }}
    </span>
 {% if block.settings.destination != blank %}
  </a>
{% else %}
  </button>
{% endif %}

{%- comment -%} MOBILE PROJECT CARD {%- endcomment -%}

{% if block.settings.destination != blank %}
  <a
    class="uc-projects__mobile-card"
    href="{{ block.settings.destination }}"
  >
{% else %}
  <div class="uc-projects__mobile-card">
{% endif %}

    
    {% if block.settings.image != blank %}
  <div class="uc-projects__mobile-image">
    {{
      block.settings.image
      | image_url: width: 1200
      | image_tag:
        widths: '400, 600, 900, 1200',
        sizes: '(max-width: 749px) 100vw, 0px',
        loading: 'lazy',
        alt: block.settings.image_alt
    }}
  </div>
{% endif %}

    <div class="uc-projects__mobile-heading">
      <span class="uc-projects__mobile-name">
        {{ block.settings.name | escape }}
      </span>

      <span class="uc-projects__mobile-status">
        {{ block.settings.status | escape }}
      </span>
    </div>

    <div class="uc-projects__mobile-metadata">
      {% for line in metadata_lines limit: 3 %}
        {% assign metadata_value = line | strip %}
        {% if metadata_value != blank %}
          <span>{{ metadata_value | escape }}</span>
        {% endif %}
      {% endfor %}
    </div>

{% if block.settings.destination != blank %}
  </a>
{% else %}
  </div>
{% endif %}
{% endfor %}
        </div>
      </div>

    </div>
  {% endif %}
</section>

{% stylesheet %}
  /* Projects layout */


  .uc-projects__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 3fr);
    gap: 0;
    align-items: start;
    padding: 0 24px 20px;
  }

  /* Left column: selected project */

  .uc-projects__left {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-right: 24px;
    position: sticky; 
    top: var(--uc-header-height, 55px);
    align-self: start;

  }

  /* Projects header */

  .uc-projects__header {
    min-width: 0;
    max-width: 100%;
  }

  .uc-projects__header h1 {
    margin: 0;
    font-size: 19px;
    font-weight: var(--font-weight-emphasis);
    letter-spacing: -0.07em;
    line-height: 1.2;
  }

  .uc-projects__header p {
    max-width: 24rem;
    margin: 0.75rem 0 1rem;
    color: var(--color-muted);
    font-size: 0.7rem;
    font-weight: var(--font-weight-emphasis);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  /* Selected project preview */

  .uc-projects__selected {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .uc-projects__selected-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .uc-projects__selected-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .uc-projects__selected-copy {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .uc-projects__selected-copy h2 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    font-weight: var(--font-weight-emphasis);
    line-height: 1.3;
  }

  .uc-projects__selected-copy p {
    max-width: 100%;
    margin: 0 0 1rem;
    color: var(--color-muted);
    font-size: 0.7rem;
    font-weight: var(--font-weight-emphasis);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  /* Right column: project index */

  .uc-projects__index {
    min-width: 0;
  }

  .uc-projects__list {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }

  /* Project rows */

  .uc-projects__item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
    min-width: 0;
    min-height: 2rem;
    padding: 0.4rem 0.5rem;
    border: 0;
    border-top: 1px solid var(--uc-line);
    background: transparent;
    color: inherit;
    text-align: left;
    font-size: 0.65rem;
    font-weight: var(--font-weight-emphasis);
    line-height: 1.5;
    cursor: pointer;
    transition: background-color 120ms ease;
  }

  .uc-projects__item:last-child {
    border-bottom: 1px solid var(--uc-line);
  }

  

  .uc-projects__item:hover,
  .uc-projects__item[aria-pressed="true"] {
    background-color: color-mix(
      in srgb,
      var(--color-foreground) 7%,
      transparent
    );
  }

  .uc-projects__item:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: -2px;
  }

  /* Mobile cards are hidden on desktop */

.uc-projects__mobile-card {
  display: none;
}

  /* Project name */

  .uc-projects__name {
    display: block;
    min-width: 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.65rem;
    font-weight: var(--font-weight-emphasis);
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .uc-projects__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-width: 0;
  width: 100%;
}



.uc-projects__status {
  white-space: nowrap;
  color: var(--uc-muted);
  font-size: 0.7rem;
  text-align: right;
}

  /* Project metadata */

  .uc-projects__metadata-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .uc-projects__metadata {
    display: block;
    min-width: 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.65rem;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Reduced motion */

  @media (prefers-reduced-motion: reduce) {
    .uc-projects__item {
      transition: none;
    }
  }

  /* PROJECTS — MOBILE */
@media screen and (max-width: 749px) {
  .uc-projects__layout {
    grid-template-columns: minmax(0, 1fr);
    padding: 20px 16px;
  }

  .uc-projects__left {
    gap: 2rem;
    padding-right: 0;
  }

  .uc-projects__item {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    padding: 0.75rem 0;
  }

.uc-projects__metadata-list {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.25rem 0.75rem;
}


  /* Hide desktop rows and show mobile cards */

  .uc-projects__item {
    display: none;
  }

  .uc-projects__mobile-card {
  display: block;
  width: 100%;
  padding-bottom: 0.75rem;
}

  .uc-projects__mobile-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  .uc-projects__mobile-name {
    min-width: 0;
    font-size: 0.65rem;
  }

  .uc-projects__mobile-status {
    flex-shrink: 0;
    color: var(--color-muted);
    font-size: 0.65rem;
    white-space: nowrap;
  }

  .uc-projects__mobile-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: 0.65rem;
  }

  /* Mobile intro ordering */

.uc-projects__layout {
  display: flex;
  flex-direction: column;
}

.uc-projects__left {
  display: none;
}

.uc-projects__index {
  display: contents;
}

.uc-projects__header {
  order: -1;
  width: 100%;
}

.uc-projects__header p { 
  margin: 2rem 0 1rem;
}

.uc-projects__list {
  order: 0;
  width: 100%;
}


.uc-projects__mobile-image {
  width: 100%;
  aspect-ratio: 4 / 3;
  margin-bottom: 0.75rem;
  overflow: hidden;
}

.uc-projects__mobile-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
}

/* TABLET PROJECTS */
@media screen and (min-width: 750px) and (max-width: 1100px) {

  /* Hide desktop preview and index rows */
  .uc-projects__left,
  .uc-projects__item {
    display: none;
  }

  /* Use the mobile card presentation */
  .uc-projects__layout {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 20px 16px;
  }

  .uc-projects__index {
    display: contents;
  }

  .uc-projects__header {
    order: -1;
    width: 100%;
    margin-bottom: 2rem;
  }

  .uc-projects__list {
    order: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    row-gap: 2rem;
    width: 100%;
  }

  .uc-projects__mobile-card {
    display: block;
    width: 100%;
    padding: 0;
  }

  .uc-projects__mobile-image {
  width: 100%;
  aspect-ratio: 3/ 4;
  overflow: hidden;
  margin-bottom: 8px;
}

.uc-projects__mobile-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
}
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.uc-projects').forEach((section) => {
    const descriptionDisplay = section.querySelector('[data-selected-description]');
    const imageDisplay = section.querySelector('[data-selected-image]');
    const projectItems = section.querySelectorAll('[data-project-item]');

    if (!imageDisplay || !projectItems.length) return;

    let activeItem = projectItems[0];

    function selectProject(item) {
      if (!item || item === activeItem) return;

      activeItem = item;

      if (descriptionDisplay) {
        descriptionDisplay.innerHTML = item.dataset.projectDescription || '';
      }

      const imageUrl = item.dataset.projectImage || '';
      const imageAlt = item.dataset.projectAlt || '';

      if (imageUrl) {
        let image = imageDisplay.querySelector('img');

        if (!image) {
          image = document.createElement('img');
          imageDisplay.appendChild(image);
        }
        
         image.srcset = item.dataset.projectImageSrcset || '';
         image.src = imageUrl;
         image.alt = imageAlt;
      } else {
        imageDisplay.replaceChildren();
      }

      projectItems.forEach((projectItem) => {
        projectItem.setAttribute(
          'aria-pressed',
          String(projectItem === activeItem)
        );
      });
    }

    projectItems.forEach((item) => {
      item.addEventListener('mouseenter', () => selectProject(item));
      item.addEventListener('focus', () => selectProject(item));
      item.addEventListener('click', () => selectProject(item));
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Projects",
  "settings": [
    {
      "type": "textarea",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "A collection of considered work, released garments, ongoing studies, and archived projects."
    }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Project name",
          "default": "Project name"
        },
            {
          "type": "text",
          "id": "status",
          "label": "Project status",
          "default": "IN DEVELOPMENT"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Project image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Project description"
        },
    
        {
          "type": "textarea",
          "id": "metadata",
          "label": "Project metadata",
          "info": "Enter up to three short descriptors, one per line. Examples: CATEGORY, YEAR, LOCATION."
        },
        {
          "type": "url",
          "id": "destination",
          "label": "Project destination",
          "info": "Optional. Link this project to a product, collection, or page."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Projects"
    }
  ]
}
{% endschema %}