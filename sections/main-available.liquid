

<section class="uc-available section-block" id="available-work">
  <div class="page-width">

    <div class="uc-available-heading">
      <div>
        <p class="uc-eyebrow">02 / AVAILABLE</p>
        <h2 class="uc-section-title">Available work</h2>
      </div>

      {% if section.settings.featured_collection != blank %}
        <a class="uc-text-link" href="{{ section.settings.featured_collection.url }}">
          View collection <span aria-hidden="true">↗</span>
        </a>
      {% endif %}
    </div>

    <p class="uc-section-intro">
      {{ section.settings.available_description | escape }}
    </p>

    {% if section.settings.featured_collection != blank
      and section.settings.featured_collection.products.size > 0
    %}
      <div class="product-grid">
        {% for product in section.settings.featured_collection.products limit: section.settings.products_to_show %}
          <article class="product-card">
            <a href="{{ product.url }}">
              <div class="product-card-media">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 801px) 25vw, 50vw',
                      alt: product.featured_image.alt
                  }}
                {% else %}
                  <div class="product-placeholder">Image pending</div>
                {% endif %}
              </div>

              <div class="product-card-info">
                <h3 class="product-card-title">{{ product.title | escape }}</h3>
                <span class="product-card-price">{{ product.price | money }}</span>
              </div>
            </a>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-state">
        <p class="uc-eyebrow">NO COLLECTION SELECTED</p>
        <p>Choose a collection in the theme editor to feature products here.</p>
      </div>
    {% endif %}

  </div>
</section>



{% schema %}
{
  "name": "Main available",
  "settings": [
    {
      "type": "header",
      "content": "Available work"
    },
    {
      "type": "textarea",
      "id": "available_description",
      "label": "Section introduction",
      "default": "Objects, garments, and things made to be lived in."
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}