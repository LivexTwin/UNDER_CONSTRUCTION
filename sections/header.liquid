<header
  class="site-header"
  data-uc-header
  data-search-url="{{ routes.search_url }}"
  data-predictive-search-url="{{ routes.predictive_search_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-change-url="{{ routes.cart_change_url }}"
  data-currency="{{ cart.currency.iso_code }}"
>
  <div class="page-width header-inner">
    <a class="wordmark" href="{{ routes.root_url }}">
      {{ section.settings.brand_name | escape }}
    </a>

    <nav class="header-nav" aria-label="Main navigation">
      <a href="{{ routes.all_products_collection_url }}">SHOP</a>
      <a href="{{ pages['projects'].url | default: routes.root_url }}">PROJECTS</a>
      <a href="{{ pages['sold'].url | default: routes.root_url }}">SOLD</a>
    </nav>

    <div class="header-utility">
   <div class="uc-search-inline" data-uc-search-inline>
  <button
    class="header-utility-button"
    type="button"
    data-uc-toggle="search"
    aria-expanded="false"
    aria-controls="uc-search-input"
  >
    SEARCH
  </button>

  <form
    class="uc-search-inline-form"
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    hidden
  >
    <label class="visually-hidden" for="uc-search-input">
      Search products
    </label>

    <input
      id="uc-search-input"
      type="search"
      name="q"
      placeholder="Search..."
      autocomplete="off"
      data-uc-search-input
    >

    <input type="hidden" name="type" value="product">

    <button
      type="button"
      data-uc-close
      aria-label="Close search"
    >X</button>
  </form>

  <div class="uc-search-dropdown">
    <a
      class="uc-view-all"
      href="{{ routes.search_url }}"
      data-uc-view-all
      hidden
    >
      VIEW ALL RESULTS ↗
    </a>

    <div
      class="uc-search-results"
      data-uc-search-results
      aria-live="polite"
    ></div>
  </div>
</div>

<button
  class="header-utility-button"
  type="button"
  data-uc-toggle="cart"
  aria-expanded="false"
  aria-controls="uc-cart-panel"
>
  <span data-uc-cart-label>
    CART (<span data-uc-cart-count>{{ cart.item_count }}</span>)
  </span>
  <span data-uc-cart-close-label hidden>CLOSE</span>
</button>
    </div>
  </div>

  <aside
    class="uc-cart-panel"
    id="uc-cart-panel"
    data-uc-panel="cart"
    aria-label="Shopping cart"
    hidden
  >
    <div class="uc-panel-heading">
      <span data-uc-cart-heading>CART / {{ cart.item_count }} ITEMS</span>
      
    </div>

    <div class="uc-cart-items" data-uc-cart-items aria-live="polite"></div>

    <div class="uc-cart-footer">
      <div class="uc-cart-subtotal">
        <span>SUBTOTAL</span>
        <span data-uc-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>

      <a class="uc-checkout" href="{{ routes.checkout_url }}">
        PROCEED TO CHECKOUT ↗
      </a>

      <p class="uc-cart-note">Shipping and taxes calculated at checkout.</p>
    </div>
  </aside>
</header>

<script src="{{ 'uc-header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "UNDER CONSTRUCTION"
    }
  ]
}
{% endschema %}