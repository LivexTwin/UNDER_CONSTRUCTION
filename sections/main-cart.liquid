
<section class="page-width cart-page">
  <div class="section-block">
    <p class="eyebrow">Commerce / Your selection</p>
    <h1 class="cart-title">Your bag<span class="mono"> ({{ cart.item_count }})</span></h1>

    {% if cart.item_count == 0 %}
      <div class="empty-state">
        <p>Your bag is empty.</p>
        <a class="text-link" href="{{ routes.all_products_collection_url }}">
          Explore available work ↗
        </a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" id="CartForm">
        <div class="cart-items">
          {% for item in cart.items %}
            <article class="cart-item">
              <a class="cart-item-image" href="{{ item.url }}">
                {% if item.image %}
                  {{
                    item.image
                    | image_url: width: 400
                    | image_tag: loading: 'lazy', alt: item.product.title
                  }}
                {% endif %}
              </a>

              <div class="cart-item-details">
                <h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                {% unless item.product.has_only_default_variant %}
                  <p class="mono muted">{{ item.variant.title | escape }}</p>
                {% endunless %}
                <p class="mono">{{ item.final_price | money }}</p>

                <label class="eyebrow" for="CartQuantity-{{ item.key }}">
                  Quantity
                </label>
                <input
                  class="cart-quantity"
                  id="CartQuantity-{{ item.key }}"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                >

                <a class="mono cart-remove" href="{{ item.url_to_remove }}">
                  Remove
                </a>
              </div>

              <p class="mono cart-line-total">{{ item.final_line_price | money }}</p>
            </article>
          {% endfor %}
        </div>

        <div class="cart-summary">
          <p>Subtotal <strong>{{ cart.total_price | money }}</strong></p>
          <p class="muted">Shipping and discounts calculated at checkout.</p>

          <div class="cart-actions">
            <button class="cart-secondary" type="submit" name="update">
              Update bag
            </button>
            <button class="product-submit" type="submit" name="checkout">
              Proceed to checkout ↗
            </button>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
