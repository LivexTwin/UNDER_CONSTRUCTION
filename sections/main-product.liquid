
<section class="page-width product-page">
  {% assign current_product = product %}

  <div class="product-layout">
    <div class="product-gallery">
      {% if current_product.media.size > 0 %}
        {% for media in current_product.media %}
          <div class="product-gallery-item">
            {% if media.media_type == 'image' %}
              {{
                media.preview_image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 900, 1200, 1600',
                  alt: media.alt
              }}
            {% else %}
              {{ media | media_tag }}
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <div class="product-placeholder">
          No product imagery available
        </div>
      {% endif %}
    </div>

    <div class="product-details">
      {% assign primary_collection = current_product.metafields.custom.primary_collection.value %}
      
      {% if section.settings.show_product_context %}
        {% if current_product.vendor != blank or primary_collection != blank %}
          <p class="eyebrow product-context">
            {{ current_product.vendor | escape }}
            {% if primary_collection != blank %}
              / {{ primary_collection.title | escape }}
            {% endif %}
          </p>
        {% endif %}
      {% endif %}

      <h1 class="product-title">{{ current_product.title | escape }}</h1>

      <p class="product-price">{{ current_product.selected_or_first_available_variant.price | money }}</p>


      <div class="product-content">
      {% form 'product', current_product, id: 'ProductForm' %}

  {% unless current_product.has_only_default_variant %}
    <fieldset class="product-variants">
      <legend class="visually-hidden">Select product variant</legend>

      <div class="product-variant-options">
        {% for variant in current_product.variants %}
          <div class="product-variant">
            <input
              class="product-variant-input"
              type="radio"
              id="Variant-{{ variant.id }}"
              name="id"
              value="{{ variant.id }}"
              {% if variant == current_product.selected_or_first_available_variant %}checked{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >

            <label
              class="product-variant-label"
              for="Variant-{{ variant.id }}"
            >
              {{ variant.title | escape }}
            </label>
          </div>
        {% endfor %}
      </div>
    </fieldset>
  {% else %}
    <input
      type="hidden"
      name="id"
      value="{{ current_product.selected_or_first_available_variant.id }}"
    >
  {% endunless %}

  <input type="hidden" name="quantity" value="1">

  <button
    class="product-submit"
    type="submit"
    name="add"
    {% unless current_product.available %}disabled{% endunless %}
  >
    {% if current_product.available %}Add to bag{% else %}Sold out{% endif %}
  </button>

{% endform %}

      {% if current_product.description != blank %}
        <div class="product-description">
          {{ current_product.description }}
        </div>
      {% endif %}

      <p class="eyebrow muted">SKU / {{ current_product.selected_or_first_available_variant.sku | default: 'Not assigned' | escape }}</p>
    </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
  "type": "checkbox",
  "id": "show_product_context",
  "label": "Show product context",
  "default": true
}
  ]
}
{% endschema %}
