{% liquid
  assign archive_collection = collections.all
%}

<section class="uc-archive" aria-label="Product archive">
<div class="uc-archive__controls" hidden>
  <button
    class="uc-archive__toggle"
    type="button"
    data-archive-toggle
    aria-label="Play automatic scrolling"
    aria-pressed="false"
  >
    PLAY
  </button>
</div>
  <div
    class="uc-archive__viewport"
    data-archive-viewport
    tabindex="0"
    aria-label="Scrollable product archive"
  >
    
    <div class="uc-archive__list" data-archive-list>

    {% paginate archive_collection.products by 50 %}
      {% for product in archive_collection.products %}
        {% assign is_sold_out = true %}

        {% for variant in product.variants %}
          {% if variant.available %}
            {% assign is_sold_out = false %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if is_sold_out %}
  {% assign archive_size = product.metafields.custom.size.value %}

  {% if archive_size == blank %}
    {% assign size_option = product.options_by_name['Size'] %}
    {% if size_option != blank %}
      {% assign archive_size = size_option.values | join: ', ' %}
    {% endif %}
  {% endif %}

  <button
    class="uc-archive__row"
    type="button"
    data-archive-item
    data-product-title="{{ product.title | escape }}"
    data-gallery-images='[
      {% for image in product.images %}
        "{{ image | image_url: width: 1600 }}"{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]'
  >
    <span class="uc-archive__identity">
      <span class="uc-archive__image">
        {% if product.featured_image %}
          {{
            product.featured_image
            | image_url: width: 240
            | image_tag: loading: 'lazy', alt: ''
          }}
        {% endif %}
      </span>

      <span class="uc-archive__name">
        {{ product.title | escape }}

        {% if archive_size != blank %}
          <span class="uc-archive__size">
            {{ archive_size | escape }}
          </span>
        {% endif %}
      </span>
    </span>

    <span class="uc-archive__metadata">
      {% if product.metafields.custom.archive_collection.value != blank %}
        <span class="uc-archive__collection">
          {{ product.metafields.custom.archive_collection.value | escape }}
        </span>
      {% endif %}

      {% if product.published_at != blank %}
        <span class="uc-archive__release-date">
          {{ product.published_at | date: '%d.%m.%y' }}
        </span>
      {% endif %}

      {% if product.metafields.custom.material.value != blank %}
        <span class="uc-archive__material">
          {{ product.metafields.custom.material.value | escape }}
        </span>
      {% endif %}

      {% if product.metafields.custom.archive_notes.value != blank %}
        <span class="uc-archive__notes">
  {{ product.metafields.custom.archive_notes.value | escape | newline_to_br }}
</span>
      {% endif %}
    </span>
  </button>

  <button
    class="uc-archive__mobile-card"
    type="button"
    data-archive-item
    data-product-title="{{ product.title | escape }}"
    data-gallery-images='[
      {% for image in product.images %}
        "{{ image | image_url: width: 1600 }}"{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]'
  >
    <span class="uc-archive__mobile-image">
      {% if product.featured_image %}
        {{
          product.featured_image
          | image_url: width: 800
          | image_tag: loading: 'lazy', alt: ''
        }}
      {% endif %}
    </span>

    <span class="uc-archive__mobile-name">
      {{ product.title | escape }}
    </span>

    <span class="uc-archive__mobile-date">
      {% if product.published_at != blank %}
        {{ product.published_at | date: '%d.%m.%y' }}
      {% else %}
        UNDATED
      {% endif %}
    </span>

    {% if product.metafields.custom.archive_collection.value != blank %}
  <span class="uc-archive__mobile-detail">
    {{ product.metafields.custom.archive_collection.value | escape }}
  </span>
{% elsif product.metafields.custom.material.value != blank %}
  <span class="uc-archive__mobile-detail">
    {{ product.metafields.custom.material.value | escape }}
  </span>
{% endif %}
  </button>

{% endif %}


      {% endfor %}
    {% endpaginate %}

    {% for block in section.blocks %}
      {% if block.type == 'archive_item' %}

        {% assign gallery_image_ids = 'image,gallery_image_2,gallery_image_3,gallery_image_4,gallery_image_5' | split: ',' %}
        {% assign image_count = 0 %}

        {% capture manual_gallery_images %}
          [
            {% for image_id in gallery_image_ids %}
              {% assign gallery_image = block.settings[image_id] %}
              {% if gallery_image %}
                {% if image_count > 0 %},{% endif %}
                "{{ gallery_image | image_url: width: 1600 }}"
                {% assign image_count = image_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          ]
        {% endcapture %}

<button
  class="uc-archive__row"
  type="button"
  data-archive-item
  data-manual-entry
  data-gallery-images='{{ manual_gallery_images | strip }}'
>
  <span class="uc-archive__identity">
    <span class="uc-archive__image">
      {% if block.settings.image %}
        {{
          block.settings.image
          | image_url: width: 240
          | image_tag: loading: 'lazy', alt: ''
        }}
      {% endif %}
    </span>

    <span class="uc-archive__name">
      {{ block.settings.name | escape }}

      {% if block.settings.size != blank %}
        <span class="uc-archive__size">
          {{ block.settings.size | escape }}
        </span>
      {% endif %}
    </span>
  </span>

  <span class="uc-archive__metadata">
    {% if block.settings.collection != blank %}
      <span class="uc-archive__collection">
        {{ block.settings.collection | escape }}
      </span>
    {% endif %}

    {% if block.settings.release_date != blank %}
      <span class="uc-archive__release-date">
        {{ block.settings.release_date | escape }}
      </span>
    {% endif %}

    {% if block.settings.material != blank %}
      <span class="uc-archive__material">
        {{ block.settings.material | escape }}
      </span>
    {% endif %}

    {% if block.settings.notes != blank %}
    <span class="uc-archive__notes">
  {{ block.settings.notes | escape | newline_to_br }}
</span>
    {% endif %}
  </span>
</button>


<button
  class="uc-archive__mobile-card"
  type="button"
  data-archive-item
  data-manual-entry
  data-gallery-images='{{ manual_gallery_images | strip }}'
  {{ block.shopify_attributes }}
>
  <span class="uc-archive__mobile-image">
    {% if block.settings.image %}
      {{
        block.settings.image
        | image_url: width: 800
        | image_tag: loading: 'lazy', alt: ''
      }}
    {% endif %}
  </span>

  <span class="uc-archive__mobile-name">
    {{ block.settings.name | escape }}
  </span>

  <span class="uc-archive__mobile-date">
    {% if block.settings.release_date != blank %}
      {{ block.settings.release_date | escape }}
    {% else %}
      UNDATED
    {% endif %}
  </span>

  {% if block.settings.collection != blank %}
    <span class="uc-archive__mobile-collection">
      {{ block.settings.collection | escape }}
    </span>
  {% endif %}

  {% if block.settings.material != blank %}
    <span class="uc-archive__mobile-material">
      {{ block.settings.material | escape }}
    </span>
  {% endif %}
</button>


      {% endif %}
    {% endfor %}

  </div>
 </div>
  <div
    class="uc-archive__gallery"
    data-archive-gallery
    role="dialog"
    aria-modal="true"
    aria-label="Image gallery"
    aria-hidden="true"
    hidden
  >
    <button
      class="uc-archive__gallery-close"
      type="button"
      data-gallery-close
      aria-label="Close gallery"
    >
      ×
    </button>

    <button
      class="uc-archive__gallery-nav uc-archive__gallery-nav--previous"
      type="button"
      data-gallery-previous
      aria-label="Previous image"
    >
      ←
    </button>

    <div class="uc-archive__gallery-content">
  <img
  class="uc-archive__gallery-image"
  data-gallery-image
  alt=""
  width="1200"
  height="1600"
>

      <p
        class="uc-archive__gallery-caption"
        data-gallery-caption
        aria-live="polite"
      ></p>
    </div>

    <button
      class="uc-archive__gallery-nav uc-archive__gallery-nav--next"
      type="button"
      data-gallery-next
      aria-label="Next image"
    >
      →
    </button>
  </div>
</section>

{% stylesheet %}
/* =========================================
   ARCHIVE — BASE
   Shared container, viewport and controls
========================================= */

  .uc-archive,
  .uc-archive * {
    box-sizing: border-box;
  }

.uc-archive__viewport {
  height: auto;
  overflow: visible;
  scrollbar-width: none;
  overscroll-behavior: auto;
}

.uc-archive__controls[hidden] {
  display: none;
}

.uc-archive__controls {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8px;
}

.uc-archive__controls {
  position: fixed;
  right: 3rem;
  z-index: 20;
}

.uc-archive__toggle {
  border:  none;
  background: transparent;
  color: var(--uc-muted);
  font: inherit;
  font-size: 10px;
  min-width: 22px;
  cursor: pointer;
  text-transform: uppercase;
}

.uc-archive__viewport {
  scrollbar-width: none;
}

.uc-archive__viewport::-webkit-scrollbar {
  display: none;
}

.uc-archive__image img {
  filter: grayscale(100%);
  transition: filter 250ms ease;
}

.uc-archive__row:hover .uc-archive__image img,
.uc-archive__row:focus-visible .uc-archive__image img {
  filter: grayscale(0%);
}

.uc-archive__toggle:focus-visible {
  outline: 1px solid var(--uc-accent, #3455db);
  outline-offset: 3px;
}

/* =========================================
   ARCHIVE — ROW SYSTEM
   Desktop archive entry layout
========================================= */

  .uc-archive {
    --uc-archive-rule: var(--uc-rule, rgba(179, 218, 23, 0.24));

    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
    color: var(--uc-ink, #252621);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
  }

  .uc-archive__list {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

/* --- IDENTITY: IMAGE / NAME / SIZE --- */
/* --- ARCHIVE ROW --- */

.uc-archive__row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  width: 100%;
  padding: 12px 8px;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.uc-archive__mobile-card {
  display: none;
  border: 0;
  border-radius: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

/* --- METADATA: COLLECTION / DATE / MATERIAL / NOTES --- */

.uc-archive__identity {
  display: flex;
  align-items: flex-start;
  flex: 0 1 40%;
  min-width: 0;
  gap: 10px;
}

.uc-archive__image {
  display: block;
  flex: 0 0 120px;
  width: 120px;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--uc-paper, #f5f4f0);
}

.uc-archive__image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.uc-archive__name {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
  min-width: 0;
  margin: 0;
  text-align: left;
  text-transform: uppercase;
  overflow-wrap: anywhere;
}

.uc-archive__size {
  display: block;
  color: var(--uc-muted, #77776e);
  text-transform: none;
}

/* --- RIGHT: METADATA --- */

.uc-archive__metadata {
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  flex: 0 1 55%;
  min-width: 0;
  gap: 2.5rem;
}

.uc-archive__metadata > *:last-child {
  margin-left: -1.25rem; /* Push the last child to the left */
}

.uc-archive__collection,
.uc-archive__release-date,
.uc-archive__material,
.uc-archive__notes {
  flex: 0 1 auto;
  min-width: 0;
   max-width: 100%;
  margin: 0;

  color: var(--uc-muted, #77776e);
  text-align: left;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
}

.uc-archive__release-date {
  font-size: 14px;
  font-weight: 600;
}

    .uc-archive__gallery[hidden] {
    display: none;
  }

  .uc-archive__gallery {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 64px;
    align-items: center;
    padding: 48px 24px 24px;
    background: rgba(0, 0, 0, 0.94);
    color: #f5f4f0;
  }

  .uc-archive__gallery-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    height: 100%;
  }

  .uc-archive__gallery-image {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 110px);
    object-fit: contain;
  }

  .uc-archive__gallery-caption {
    margin: 12px 0 0;
    font: inherit;
    text-align: center;
  }

  .uc-archive__gallery-close,
  .uc-archive__gallery-nav {
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .uc-archive__gallery-close {
    position: absolute;
    top: 16px;
    right: 24px;
    font-size: 32px;
  }

  .uc-archive__gallery-nav {
    padding: 16px;
    font-size: 28px;
  }

  .uc-archive__gallery button:focus-visible {
    outline: 2px solid var(--uc-accent, #3455db);
    outline-offset: 3px;
  }

  .uc-archive__gallery-nav:disabled {
  opacity: 0.3;
  cursor: default;
}

  @media (max-width: 700px) {
    .uc-archive__gallery {
      grid-template-columns: 40px minmax(0, 1fr) 40px;
      padding: 48px 8px 16px;
    }

    .uc-archive__gallery-nav {
      padding: 8px;
      font-size: 22px;
    }

    .uc-archive__gallery-close {
      right: 16px;
    }
  }

/* =========================================
   ARCHIVE — MOBILE
   700px and below
   Two-column cards / no autoplay / grayscale
========================================= */

@media (max-width: 700px) {
  /* Hide desktop rows and use card grid */
  .uc-archive__row {
    display: none;
  }

  .uc-archive__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 12px;
    row-gap: 24px;
    padding: 0 12px 24px;
  }

  /* Mobile card structure */
  .uc-archive__mobile-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    width: 100%;
    min-width: 0;
    padding: 0 0 12px;
  }

  /* Card image */
  .uc-archive__mobile-image {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--uc-paper, #f5f4f0);
  }

  .uc-archive__mobile-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 250ms ease;
  }

  /* Card typography */
  .uc-archive__mobile-name {
    font-size: 12px;
    line-height: 1.3;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .uc-archive__mobile-date,
  .uc-archive__mobile-detail {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    color: var(--uc-muted, #777);
  }

  /* No autoplay controls on touch layouts */
  .uc-archive__controls {
    display: none !important;
  }
}


/* =========================================
   ARCHIVE — TABLET
   701px–1100px
   Single-row layout / no autoplay / grayscale
========================================= */

@media (min-width: 701px) and (max-width: 1100px) {
  .uc-archive__controls {
    display: none ;
  }

  .uc-archive__row:hover .uc-archive__image img,
  .uc-archive__row:focus-visible .uc-archive__image img {
    filter: grayscale(100%);
  }
}


/* =========================================
   ARCHIVE — ACCESSIBILITY
   Respect reduced-motion preferences
========================================= */

  @media (prefers-reduced-motion: reduce) {
    .uc-archive,
    .uc-archive * {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }


{% endstylesheet %}


{% javascript %}
 
(() => {
  if (window.ucArchiveGalleryInitialized) return;
  window.ucArchiveGalleryInitialized = true;

  let activeGallery = null;
  let activeImages = [];
  let activeIndex = 0;
  let previousFocus = null;
  let previousBodyOverflow = '';
  let galleryOpen = false;

  // Shared callback so closing the gallery can resume archive scrolling.
  let resumeArchiveAnimation = () => {};

  const getControls = (gallery) => ({
    image: gallery.querySelector('[data-gallery-image]'),
    caption: gallery.querySelector('[data-gallery-caption]'),
    close: gallery.querySelector('[data-gallery-close]'),
    previous: gallery.querySelector('[data-gallery-previous]'),
    next: gallery.querySelector('[data-gallery-next]')
  });

  const showImage = () => {
    if (!activeGallery || !activeImages.length) return;

    const controls = getControls(activeGallery);

    controls.image.src = activeImages[activeIndex];

    controls.caption.textContent =
      `${activeGallery.dataset.productTitle || ''} — ${activeIndex + 1} / ${activeImages.length}`;

    const multipleImages = activeImages.length > 1;

    controls.previous.disabled = !multipleImages;
    controls.next.disabled = !multipleImages;
  };

  const closeGallery = () => {
    if (!activeGallery) return;

    const gallery = activeGallery;
    const controls = getControls(gallery);

    gallery.hidden = true;
    gallery.setAttribute('aria-hidden', 'true');
    controls.image.removeAttribute('src');

    document.body.style.overflow = previousBodyOverflow;

    activeGallery = null;
    activeImages = [];
    galleryOpen = false;

    if (previousFocus && previousFocus.isConnected) {
      previousFocus.focus();
    }

    previousFocus = null;

    resumeArchiveAnimation();
  };

  const openGallery = (row) => {
    const archive = row.closest('.uc-archive');
    if (!archive) return;

    const gallery = archive.querySelector('[data-archive-gallery]');
    if (!gallery) return;

    let images = [];

    try {
      images = JSON.parse(
        row.getAttribute('data-gallery-images') || '[]'
      );
    } catch (error) {
      console.error('Could not read archive gallery images:', error);
    }

    if (!images.length) return;

    if (activeGallery) closeGallery();

    activeGallery = gallery;
    activeImages = images;
    activeIndex = 0;
    previousFocus = row;
    galleryOpen = true;

    previousBodyOverflow = document.body.style.overflow;

   gallery.dataset.productTitle =
  row.dataset.productTitle ||
  row.querySelector(
    '.uc-archive__name, .uc-archive__mobile-name'
  )?.textContent.trim() ||
  '';

    gallery.hidden = false;
    gallery.setAttribute('aria-hidden', 'false');

    document.body.style.overflow = 'hidden';

    showImage();
    getControls(gallery).close.focus();
  };

  // Document-level automatic scrolling.
  const setupArchiveScrolling = () => {
    const archives = document.querySelectorAll('.uc-archive');

    archives.forEach((archive) => {
      if (archive.dataset.scrollInitialized) return;

      archive.dataset.scrollInitialized = 'true';

      const viewport = archive.querySelector('[data-archive-viewport]');
      const toggle = archive.querySelector('[data-archive-toggle]');
      const controls = archive.querySelector('.uc-archive__controls');

      if (!viewport || !toggle || !controls) return;

      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );

      const desktop = window.matchMedia('(min-width: 1101px)');

      const pageScroller =
        document.scrollingElement || document.documentElement;

      let direction = 1;
      let playing = false;
      let hovering = false;
      let focused = false;
      let userPaused = false;
      let frame = null;
      let previousTime = 0;
      let currentPosition = 0;

      const speed = 25;

      // Measure page overflow without allowing the controls
      // themselves to create the overflow that makes them appear.
      const canScroll = () => {
        const wasHidden = controls.hidden;

        controls.hidden = true;

        const hasOverflow =
          pageScroller.scrollHeight > window.innerHeight + 1;

        controls.hidden = wasHidden;

        return hasOverflow;
      };

      const updateButton = () => {
        toggle.textContent = playing ? 'pause' : 'resume';

        toggle.setAttribute(
          'aria-label',
          playing
            ? 'Pause automatic scrolling'
            : 'Play automatic scrolling'
        );

        toggle.setAttribute('aria-pressed', String(playing));
      };

      const updateVisibility = () => {
        const hasOverflow = canScroll();

        controls.hidden = !hasOverflow;

        return hasOverflow;
      };

      const stopAnimation = () => {
        if (frame !== null) {
          cancelAnimationFrame(frame);
          frame = null;
        }

        previousTime = 0;
      };

      const pauseAnimation = () => {
        stopAnimation();
      };

      const animate = (time) => {
        if (!playing) return;

        if (!previousTime) previousTime = time;

        const elapsed = Math.min(
          (time - previousTime) / 1000,
          0.05
        );

        previousTime = time;

        const maxScroll =
          pageScroller.scrollHeight - window.innerHeight;

        if (maxScroll <= 1) {
          setPlaying(false);
          updateVisibility();
          return;
        }

        currentPosition += direction * speed * elapsed;

        let nextPosition = currentPosition;

        if (nextPosition >= maxScroll) {
          nextPosition = maxScroll;
          direction = -1;
        } else if (nextPosition <= 0) {
          nextPosition = 0;
          direction = 1;
        }

        window.scrollTo({
          top: nextPosition,
          behavior: 'instant'
        });

        currentPosition = nextPosition;

        frame = requestAnimationFrame(animate);
      };

      const startAnimation = () => {
        if (
          !playing ||
          !desktop.matches ||
          reducedMotion.matches ||
          hovering ||
          focused ||
          galleryOpen ||
          document.hidden ||
          !updateVisibility()
        ) {
          return;
        }

        if (frame === null) {
          previousTime = 0;
          currentPosition = window.scrollY;

          frame = requestAnimationFrame(animate);
        }
      };

      const setPlaying = (value) => {
        playing = value && updateVisibility();

        updateButton();

        if (playing) {
          startAnimation();
        } else {
          pauseAnimation();
        }
      };
  
            let manualScrollTimer = null;

      const handleManualScroll = () => {
        pauseAnimation();

        clearTimeout(manualScrollTimer);

        manualScrollTimer = setTimeout(() => {
          currentPosition = window.scrollY;
          startAnimation();
        }, 500);
      };

      window.addEventListener('wheel', handleManualScroll, {
        passive: true
      });

      window.addEventListener('touchmove', handleManualScroll, {
        passive: true
      });

      // Keep the shared gallery callback connected to this archive.
      resumeArchiveAnimation = () => {
        if (
          !userPaused &&
          desktop.matches &&
          !reducedMotion.matches &&
          canScroll()
        ) {
          setPlaying(true);
        }
      };

      // Manual PLAY / PAUSE.
      toggle.addEventListener('click', () => {
        userPaused = playing;
        setPlaying(!playing);
      });

      

      // Pause when the pointer enters an archive item.
      viewport.addEventListener('pointerover', (event) => {
        if (event.target.closest('[data-archive-item]')) {
          hovering = true;
          pauseAnimation();
        }
      });

      viewport.addEventListener('pointerout', (event) => {
        if (
          event.target.closest('[data-archive-item]') &&
          !event.relatedTarget?.closest('[data-archive-item]')
        ) {
          hovering = false;
          startAnimation();
        }
      });

      // Pause while keyboard focus is inside the archive.
      viewport.addEventListener('focusin', () => {
        focused = true;
        pauseAnimation();
      });

      viewport.addEventListener('focusout', (event) => {
        if (!viewport.contains(event.relatedTarget)) {
          focused = false;
          startAnimation();
        }
      });

      // Recalculate when the screen size changes.
      const refreshScrollState = () => {
        const hasOverflow = updateVisibility();

        if (!hasOverflow) {
          userPaused = false;
          setPlaying(false);
          return;
        }

        if (!desktop.matches || reducedMotion.matches) {
          setPlaying(false);
          return;
        }

        if (!userPaused && !playing) {
          setPlaying(true);
        } else if (playing) {
          startAnimation();
        }
      };

      desktop.addEventListener('change', refreshScrollState);

      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches) {
          setPlaying(false);
        } else {
          refreshScrollState();
        }
      });

      window.addEventListener('resize', refreshScrollState);
      window.addEventListener('load', refreshScrollState);

      // Detect content and image dimensions changing.
      if ('ResizeObserver' in window) {
        const resizeObserver = new ResizeObserver(() => {
          refreshScrollState();
        });

        resizeObserver.observe(document.documentElement);
        resizeObserver.observe(archive);
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          pauseAnimation();
        } else {
          startAnimation();
        }
      });

      // Initial state.
      refreshScrollState();
    });
  };

  setupArchiveScrolling();

  // Archive item and gallery interactions.
  document.addEventListener('click', (event) => {
    const row = event.target.closest('[data-archive-item]');

    if (row) {
      openGallery(row);
      return;
    }

    if (!activeGallery) return;

    if (event.target.closest('[data-gallery-close]')) {
      closeGallery();
    } else if (event.target.closest('[data-gallery-previous]')) {
      activeIndex =
        (activeIndex - 1 + activeImages.length) % activeImages.length;

      showImage();
    } else if (event.target.closest('[data-gallery-next]')) {
      activeIndex =
        (activeIndex + 1) % activeImages.length;

      showImage();
    } else if (event.target === activeGallery) {
      closeGallery();
    }
  });

  // Gallery keyboard navigation.
  document.addEventListener('keydown', (event) => {
    if (!activeGallery) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeGallery();
      return;
    }

    if (activeImages.length > 1 && event.key === 'ArrowLeft') {
      event.preventDefault();

      activeIndex =
        (activeIndex - 1 + activeImages.length) % activeImages.length;

      showImage();
    }

    if (activeImages.length > 1 && event.key === 'ArrowRight') {
      event.preventDefault();

      activeIndex =
        (activeIndex + 1) % activeImages.length;

      showImage();
    }

    if (event.key === 'Tab') {
      const focusable = Array.from(
        activeGallery.querySelectorAll(
          'button:not([hidden]):not(:disabled)'
        )
      );

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (
        !event.shiftKey &&
        document.activeElement === last
      ) {
        event.preventDefault();
        first.focus();
      }
    }
  });
})();

{% endjavascript %}


