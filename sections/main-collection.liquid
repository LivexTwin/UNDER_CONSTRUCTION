
<section class="collection-page">
 
<div class="collection-sidebar">
  <div class="collection-index-heading">
    <h2>{{ section.settings.index_title | escape }}</h2>
  </div>

  <aside class="collection-index" aria-label="Catalog index">
  <div
    class="collection-filter-overlay"
    id="collection-filter-overlay"
    role="dialog"
    aria-modal="true"
    aria-label="Filter and sort products"
  >
    <div class="collection-filter-overlay__header">
      <span>FILTER / SORT</span>

      <button
        type="button"
        class="collection-filter-overlay__close"
        data-filter-close
        aria-label="Close filters"
      >
        CLOSE 
      </button>
    </div>

    <form
  class="collection-filter-form"
  id="collection-filter-form"
  method="get"
  action="{{ collection.url }}"
>

{% for filter in collection.filters %}
  {% assign filter_label = filter.label | downcase %}
  {% assign supported_filter = false %}

  {% case filter_label %}
    {% when 'category', 'product category', 'product type', 'type', 'vendor', 'brand', 'size' %}
      {% assign supported_filter = true %}
  {% endcase %}

  {% unless supported_filter or filter.type == 'price_range' %}
    {% for value in filter.active_values %}
      <input
        type="hidden"
        name="{{ value.param_name | escape }}"
        value="{{ value.value | escape }}"
        data-preserved-filter
      >
    {% endfor %}
  {% endunless %}
{% endfor %}

  <div class="collection-filter-overlay__content">

      {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}


      <div class="collection-index-filters">
    {% comment %} Find the filter with the most options {% endcomment %}
    {% assign largest_filter_size = 0 %}
    {% assign largest_filter_param = blank %}

    {% for filter in collection.filters %}
      {% assign filter_label = filter.label | downcase %}

      {% assign supported_filter = false %}

      {% case filter_label %}
        {% when 'category', 'product category', 'product type', 'type', 'vendor', 'brand', 'size' %}
          {% assign supported_filter = true %}
      {% endcase %}

      {% if supported_filter and filter.values.size > largest_filter_size %}
        {% assign largest_filter_size = filter.values.size %}
        {% assign largest_filter_param = filter.param_name %}
      {% endif %}
    {% endfor %}


    {% assign has_active_supported_filter = false %}

{% for filter in collection.filters %}
  {% assign filter_label = filter.label | downcase %}

  {% case filter_label %}
    {% when 'category', 'product category', 'product type', 'type', 'vendor', 'brand', 'size' %}
      {% if filter.active_values.size > 0 %}
        {% assign has_active_supported_filter = true %}
      {% endif %}
  {% endcase %}
{% endfor %}

    {% comment %} CATEGORY, BRAND AND SIZE {% endcomment %}
    {% for filter in collection.filters %}

      {% assign filter_label = filter.label | downcase %}
      {% assign filter_title = blank %}

      {% case filter_label %}
        {% when 'category', 'product category', 'product type', 'type' %}
          {% assign filter_title = 'CATEGORY' %}

        {% when 'vendor', 'brand' %}
          {% assign filter_title = 'BRAND' %}

        {% when 'size' %}
          {% assign filter_title = 'SIZE' %}
      {% endcase %}

      {% if filter_title != blank %}
       {% assign open_filter_group = false %}

{% if filter.active_values.size > 0 %}
  {% assign open_filter_group = true %}
{% elsif has_active_supported_filter == false and filter.param_name == largest_filter_param %}
  {% assign open_filter_group = true %}
{% endif %}

<details
  class="collection-index-group"
  {% if open_filter_group %}open{% endif %}
>
          <summary class="collection-index-label">
            <span>{{ filter_title }}</span>
            <span class="collection-index-indicator" aria-hidden="true"></span>
          </summary>

          <div class="collection-index-content">
            <ul class="collection-filter-values" role="list">
              {% for value in filter.values %}
             <li>
  <div class="collection-filter-option-desktop">
    <a
      href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
      {% if value.active %}aria-current="true"{% endif %}
    >
      <span>
        {% if filter_title == 'SIZE' and value.label contains '(' %}
          {{ value.label | split: '(' | last | remove: ')' | strip | escape }}
        {% else %}
          {{ value.label | escape }}
        {% endif %}
      </span>

      {% if value.active %}
        <span aria-hidden="true"> ×</span>
      {% endif %}
    </a>
  </div>

  <div class="collection-filter-option-mobile">
    <label class="collection-filter-option">
      <input
        type="checkbox"
        name="{{ value.param_name | escape }}"
        value="{{ value.value | escape }}"
        {% if value.active %}checked{% endif %}
        {% if value.count == 0 and value.active == false %}disabled{% endif %}
      >

      <span>
        {% if filter_title == 'SIZE' and value.label contains '(' %}
          {{ value.label | split: '(' | last | remove: ')' | strip | escape }}
        {% else %}
          {{ value.label | escape }}
        {% endif %}
      </span>
    </label>
  </div>
</li>
              {% endfor %}
            </ul>
          </div>
        </details>
      {% endif %}

    {% endfor %}


    {% comment %} PRICE — ALWAYS VISIBLE {% endcomment %}
    {% for filter in collection.filters %}
  {% if filter.type == 'price_range' %}

    <div class="collection-index-group collection-index-price">
      <p class="collection-index-label">PRICE</p>

    
        <label class="collection-price-filter__min-label"
          for="Filter-{{ filter.param_name }}-GTE">
          MIN
        </label>

        <input
          class="collection-price-filter__min-input"
          id="Filter-{{ filter.param_name }}-GTE"
          name="{{ filter.min_value.param_name }}"
          type="number"
          min="0"
          placeholder="0"
          {% if filter.min_value.value %}
            value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
          {% endif %}
        >

        <label class="collection-price-filter__max-label"
          for="Filter-{{ filter.param_name }}-LTE">
          MAX
        </label>

        <input
          class="collection-price-filter__max-input"
          id="Filter-{{ filter.param_name }}-LTE"
          name="{{ filter.max_value.param_name }}"
          type="number"
          min="0"
          placeholder="—"
          {% if filter.max_value.value %}
            value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
          {% endif %}
        >
        {% assign price_filter_active = false %}

{% if filter.min_value.value != nil or filter.max_value.value != nil %}
  {% assign price_filter_active = true %}
{% endif %}

<button
  type="submit"
  class="collection-price-apply"
  {% if price_filter_active %}hidden{% endif %}
>
  APPLY
</button>

<button
  type="button"
  class="collection-price-reset"
  data-price-reset
  data-price-min-param="{{ filter.min_value.param_name }}"
  data-price-max-param="{{ filter.max_value.param_name }}"
  {% unless price_filter_active %}hidden{% endunless %}
>
  RESET
</button>
    </div>

  {% endif %}
{% endfor %}

            </div>
             <details class="collection-index-group collection-sort-accordion">
  <summary class="collection-index-label">
    <span>SORT</span>
    <span class="collection-index-indicator" aria-hidden="true"></span>
  </summary>

  <div class="collection-index-content">
    <fieldset class="collection-toolbar-controls collection-sort-mobile">

    {% for option in collection.sort_options %}
      {% case option.value %}
        {% when 'manual' %}
          {% assign sort_label = 'FEATURED' %}
        {% when 'created-descending' %}
          {% assign sort_label = 'NEWEST' %}
        {% when 'price-ascending' %}
          {% assign sort_label = 'PRICE ↑' %}
        {% when 'price-descending' %}
          {% assign sort_label = 'PRICE ↓' %}
        {% else %}
          {% assign sort_label = blank %}
      {% endcase %}

      {% if sort_label != blank %}
        <label class="collection-sort-option">
          <input
            type="radio"
            name="sort_by"
            value="{{ option.value | escape }}"
            {% if option.value == sort_by %}checked{% endif %}
          >
          <span>{{ sort_label }}</span>
        </label>
      {% endif %}
    {% endfor %}
      </fieldset>
  </div>
</details>
    </div>

    <div class="collection-filter-overlay__footer">
        <button
          type="button"
          data-filter-clear
        >
          CLEAR ALL
        </button>

        <button
          type="submit"
          data-filter-apply
        >
          APPLY →
        </button>
      </div>
        </form>
    </div>
    
  </aside>
</div>

<div class="collection-workspace">

    {% if section.settings.hero_image != blank %}
      <section class="uc-collection-hero" aria-label="Featured content">
        <a
          class="uc-collection-hero-media{% if section.settings.hero_crop %} uc-collection-hero-media--crop{% endif %}"
          {% if section.settings.hero_link != blank %}
            href="{{ section.settings.hero_link }}"
          {% endif %}
        >
          {{
            section.settings.hero_image
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              widths: '750, 1100, 1500, 2000, 2400',
              sizes: '(min-width: 761px) calc(100vw - 300px), 100vw',
              alt: section.settings.hero_image.alt
          }}
        </a>

        {% if section.settings.hero_heading != blank or section.settings.hero_text != blank %}
          <div class="uc-collection-hero-caption">
            {% if section.settings.hero_heading != blank %}
              <h2>{{ section.settings.hero_heading | escape }}</h2>
            {% endif %}

            {% if section.settings.hero_text != blank %}
              <p>{{ section.settings.hero_text | escape }}</p>
            {% endif %}
          </div>
        {% endif %}
      </section>
    {% endif %}

    <header class="collection-toolbar">
 <p class="collection-eyebrow">
  PRODUCTS / {{ collection.products_count }} ITEMS
</p>


{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}

<fieldset class="collection-toolbar-controls collection-sort-desktop">
  <legend>SORT:</legend>

  {% for option in collection.sort_options %}
    {% case option.value %}
      {% when 'manual' %}
        {% assign sort_label = 'FEATURED' %}
      {% when 'created-descending' %}
        {% assign sort_label = 'NEWEST' %}
      {% when 'price-ascending' %}
        {% assign sort_label = 'PRICE ↑' %}
      {% when 'price-descending' %}
        {% assign sort_label = 'PRICE ↓' %}
      {% else %}
        {% assign sort_label = blank %}
    {% endcase %}

    {% if sort_label != blank %}
      <label class="collection-sort-option">
        <input
          type="radio"
          name="collection-sort"
          value="{{ option.value | escape }}"
          {% if option.value == sort_by %}checked{% endif %}
        >
        <span>{{ sort_label }}</span>
      </label>
    {% endif %}
  {% endfor %}
</fieldset>
  
</header>

<button
  type="button"
  class="collection-filter-trigger"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="collection-filter-overlay"
>
  FILTER <span>+</span>
</button>

    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products.size > 0 %}
        <div class="collection-grid">
          {% for product in collection.products %}
           <article class="collection-card">
  <a
    class="collection-card-image"
    href="{{ product.url }}"
    aria-label="{{ product.title | escape }}"
  >
    {% if product.featured_image %}
      {{
        product.featured_image
        | image_url: width: 1000
        | image_tag:
          loading: 'lazy',
          widths: '300, 500, 700, 1000',
          sizes: '(min-width: 1200px) 40vw, (min-width: 761px) 35vw, 50vw',
          alt: product.featured_image.alt
      }}
    {% else %}
      <div class="collection-card-placeholder">
        IMAGE NOT AVAILABLE
      </div>
    {% endif %}
  </a>

  <div class="collection-card-info">


    <h2 class="collection-card-title">
      <a href="{{ product.url }}">
        {{ product.title | escape }}
      </a>
    </h2>

    <p class="collection-card-price">
      {% if product.price_varies %}
        {{ product.price_min | money }} – {{ product.price_max | money }}
      {% else %}
        {{ product.price | money }}
      {% endif %}
    </p>
  </div>
</article>
          {% endfor %}
        </div>

        {% if paginate.next %}
  <div
    class="collection-load-more"
    data-collection-load-more
    data-next-url="{{ paginate.next.url }}"
  >
    <button
      type="button"
      class="collection-load-more__button"
      data-load-more-button
    >
      LOAD MORE PRODUCTS →
    </button>
  </div>
{% endif %}

<p
  class="visually-hidden"
  data-collection-status
  role="status"
  aria-live="polite"
  aria-atomic="true"
></p>

<noscript>
  {% if paginate.pages > 1 %}
    <nav class="collection-pagination" aria-label="Pagination">
      {% if paginate.previous %}
        <a href="{{ paginate.previous.url }}">← PREVIOUS</a>
      {% else %}
        <span class="pagination-disabled">← PREVIOUS</span>
      {% endif %}

      <span class="pagination-count">
        PAGE {{ paginate.current_page }} / {{ paginate.pages }}
      </span>

      {% if paginate.next %}
        <a href="{{ paginate.next.url }}">NEXT →</a>
      {% else %}
        <span class="pagination-disabled">NEXT →</span>
      {% endif %}
    </nav>
  {% endif %}
</noscript>
      {% else %}
        <div class="collection-empty">
          <p>NOTHING AVAILABLE IN THIS COLLECTION.</p>
          <a href="{{ routes.all_products_collection_url }}">VIEW ALL PRODUCTS →</a>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<script>
  (() => {
    /* COLLECTION SORT */

    /* COLLECTION FILTER OVERLAY */
const filterTrigger = document.querySelector('.collection-filter-trigger');
const filterOverlay = document.querySelector('#collection-filter-overlay');
const filterClose = document.querySelector('[data-filter-close]');
const filterForm = document.querySelector('#collection-filter-form');
const filterClear = document.querySelector('[data-filter-clear]');
const priceReset = document.querySelector('[data-price-reset]');
const mobileSort = document.querySelector('.collection-sort-mobile');

mobileSort?.querySelectorAll('input[type="radio"]').forEach((radio) => {
  radio.addEventListener('click', () => {
    if (radio.dataset.wasChecked === 'true') {
      radio.checked = false;
      radio.dataset.wasChecked = 'false';
    } else {
      mobileSort.querySelectorAll('input[type="radio"]').forEach((input) => {
        input.dataset.wasChecked = 'false';
      });

      radio.dataset.wasChecked = 'true';
    }
  });
});

filterForm?.addEventListener('submit', (event) => {
  const isPriceApply = event.submitter?.matches(
    '.collection-price-apply'
  );

  const isPriceInputSubmit = !event.submitter &&
    document.activeElement?.matches(
      '.collection-price-filter__min-input, .collection-price-filter__max-input'
    );

  if (!isPriceApply && !isPriceInputSubmit) return;

  const priceInputs = filterForm.querySelectorAll(
    '.collection-price-filter__min-input, .collection-price-filter__max-input'
  );

  const hasPriceValue = [...priceInputs].some(
    (input) => input.value.trim() !== ''
  );

  if (!hasPriceValue) {
    event.preventDefault();
  }
});

priceReset?.addEventListener('click', () => {
  const url = new URL(window.location.href);

  url.searchParams.delete(priceReset.dataset.priceMinParam);
  url.searchParams.delete(priceReset.dataset.priceMaxParam);

  url.searchParams.delete('page');

  window.location.href = url.toString();
});

filterClear?.addEventListener('click', () => {
  if (!filterForm) return;

  filterForm.querySelectorAll('input[type="checkbox"]').forEach((input) => {
    input.checked = false;
  });

  filterForm.querySelectorAll('input[type="radio"]').forEach((input) => {
    input.checked = false;
  });

    filterForm.querySelectorAll('[data-preserved-filter]').forEach((input) => {
    input.disabled = true;
  });

  filterForm.querySelectorAll('input[type="number"]').forEach((input) => {
    input.value = '';
  });
});

const mobileFilterGroups = filterOverlay?.querySelectorAll(
  '.collection-index-group[open]'
);

const syncMobileFilterGroups = () => {
  if (window.matchMedia('(max-width: 760px)').matches) {
    mobileFilterGroups?.forEach((group) => {
      group.removeAttribute('open');
    });
  }
};

syncMobileFilterGroups();

const openFilters = () => {
  if (!filterOverlay) return;

  filterOverlay.classList.add('is-open');
  filterTrigger?.setAttribute('aria-expanded', 'true');
  document.body.style.overflow = 'hidden';
  filterClose?.focus();
};

const closeFilters = () => {
  if (!filterOverlay) return;

  filterOverlay.classList.remove('is-open');
  filterTrigger?.setAttribute('aria-expanded', 'false');
  document.body.style.overflow = '';
  filterTrigger?.focus();
};

filterTrigger?.addEventListener('click', openFilters);
filterClose?.addEventListener('click', closeFilters);

document.addEventListener('keydown', (event) => {
  if (event.key === 'Escape' && filterOverlay?.classList.contains('is-open')) {
    closeFilters();
  }
});

   const desktopSortOptions = document.querySelectorAll(
  '.collection-sort-desktop input[name="collection-sort"]'
);

desktopSortOptions.forEach((option) => {
  option.addEventListener('change', () => {
    if (!option.checked) return;

    const url = new URL(window.location.href);

    url.searchParams.set('sort_by', option.value);
    url.searchParams.delete('page');

    window.location.href = url.toString();
  });
});

    /* COLLECTION INFINITE SCROLL */
    const grid = document.querySelector('.collection-grid');
    const loadMore = document.querySelector('[data-collection-load-more]');
    const status = document.querySelector('[data-collection-status]');

    if (!grid || !loadMore || !status) return;

    const button = loadMore.querySelector('[data-load-more-button]');

    if (!button) return;

    let loading = false;
    let failed = false;

    const loadNextPage = async (manual = false) => {
      if (loading || !loadMore.dataset.nextUrl) return;
      if (failed && !manual) return;
      if (loadMore.dataset.complete === 'true') return;

      loading = true;
      failed = false;

      button.disabled = true;
      button.textContent = 'LOADING...';
      loadMore.removeAttribute('data-error');

      grid.setAttribute('aria-busy', 'true');
      status.textContent = 'Loading more products.';

      try {
        const response = await fetch(loadMore.dataset.nextUrl);

        if (!response.ok) {
          throw new Error('Unable to load products.');
        }

        const html = await response.text();
        const documentParser = new DOMParser();
        const nextDocument = documentParser.parseFromString(
          html,
          'text/html'
        );

        const nextGrid = nextDocument.querySelector('.collection-grid');

        if (!nextGrid) {
          throw new Error('Product grid not found.');
        }

        const products = Array.from(nextGrid.children);

        if (!products.length) {
          throw new Error('No products found.');
        }

        products.forEach((product) => {
          grid.appendChild(document.importNode(product, true));
        });

        const nextLoadMore = nextDocument.querySelector(
          '[data-collection-load-more]'
        );

        if (nextLoadMore?.dataset.nextUrl) {
          loadMore.dataset.nextUrl = nextLoadMore.dataset.nextUrl;
          button.textContent = 'LOAD MORE PRODUCTS →';
          button.disabled = false;
        } else {
          loadMore.dataset.complete = 'true';
          loadMore.removeAttribute('data-next-url');
          button.textContent = 'ALL PRODUCTS LOADED';
          button.setAttribute('aria-disabled', 'true');

          observer?.disconnect();
        }

        status.textContent = `${products.length} more products loaded.`;

      } catch (error) {
        failed = true;

        loadMore.dataset.error = 'true';
        button.disabled = false;
        button.textContent = 'TRY AGAIN →';

        status.textContent =
          'More products could not be loaded. Use the try again button.';

        console.error(error);

      } finally {
        loading = false;
        grid.setAttribute('aria-busy', 'false');

        if (loadMore.dataset.complete !== 'true' && !failed) {
          button.disabled = false;
        }
      }
    };

    /* Manual keyboard-accessible fallback */
    button.addEventListener('click', () => {
      loadNextPage(true);
    });

    /* Automatic loading */
    let observer;

    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            loadNextPage();
          }
        },
        {
          rootMargin: '100px 0px'
        }
      );

      observer.observe(loadMore);
    } else {
      loadMore.dataset.manualOnly = 'true';
    }
  })();
</script>

  {% schema %}
  {
    "name": "Main collection",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_description",
        "label": "Show collection description",
        "default": true
      },
      {
        "type": "range",
        "id": "products_per_page",
        "label": "Products per page",
        "min": 4,
        "max": 24,
        "step": 4,
        "default": 12
      },
      {
       "type": "text",
       "id": "index_title",
       "label": "Index heading",
       "default": "CATALOG"
},
{
  "type": "header",
  "content": "Collection hero"
},
{
  "type": "image_picker",
  "id": "hero_image",
  "label": "Hero image"
},
{
  "type": "checkbox",
  "id": "hero_crop",
  "label": "Crop hero image",
  "default": false,
  "info": "Off displays the entire image. On crops to a wide 2:1 frame."
},
{
  "type": "text",
  "id": "hero_heading",
  "label": "Hero heading"
},
{
  "type": "text",
  "id": "hero_text",
  "label": "Hero text"
},
{
  "type": "url",
  "id": "hero_link",
  "label": "Hero link"
},


    ]
  }
  {% endschema %}